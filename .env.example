# XiaomiMiMo-TUI environment
# Shell-exported variables override values in this file.
# Copy this file to `.env`, then uncomment only the values you want to use.

# Xiaomi MiMo API (default provider)
# Get an API key from XiaomiMiMo, then keep it local in `.env`.
# XIAOMIMIMO_API_KEY=

# Official OpenAI-compatible endpoint:
# XIAOMIMIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# Anthropic-compatible endpoint for external Anthropic SDK/proxy use:
# XIAOMIMIMO_ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic

# Xiaomi MiMo model selection. Compatibility aliases such as `xiaomimimo-chat`
# normalize to `mimo-v2-flash` in the TUI.
# XIAOMIMIMO_MODEL=mimo-v2.5-pro
# XIAOMIMIMO_MODEL=mimo-v2-flash

# NVIDIA NIM-hosted Xiaomi MiMo
# Use this provider when routing through NVIDIA's OpenAI-compatible endpoint.
# XIAOMIMIMO_PROVIDER=nvidia-nim
# NVIDIA_API_KEY=
# NVIDIA_NIM_API_KEY=
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_NIM_MODEL=mimo-v2.5-pro

# Logging
# `XIAOMIMIMO_LOG_LEVEL` is forwarded by the facade; `RUST_LOG` enables the
# TUI's lightweight verbose logs for info/debug/trace directives.
# XIAOMIMIMO_LOG_LEVEL=debug
# RUST_LOG=xiaomimimo_tui=debug

# Agent safety defaults
# `on-request` asks before higher-risk work; `workspace-write` keeps writes
# inside the workspace unless a sandbox elevation path is explicitly used.
# XIAOMIMIMO_APPROVAL_POLICY=on-request
# XIAOMIMIMO_SANDBOX_MODE=workspace-write
# XIAOMIMIMO_ALLOW_SHELL=true

# Optional extension paths
# XIAOMIMIMO_SKILLS_DIR=~/.xiaomimimo/skills
# XIAOMIMIMO_MCP_CONFIG=~/.xiaomimimo/mcp.json
