{
  "name": "xiaomimimo-tui",
  "version": "0.6.6",
  "xiaomimimoBinaryVersion": "0.6.6",
  "description": "Windows x64 npm wrapper for XiaomiMiMo-TUI chat and speech binaries.",
  "author": "xyuai",
  "license": "MIT",
  "homepage": "https://github.com/xyuai/XiaomiMiMo-TUI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyuai/XiaomiMiMo-TUI.git"
  },
  "bugs": {
    "url": "https://github.com/xyuai/XiaomiMiMo-TUI/issues"
  },
  "keywords": [
    "xiaomimimo",
    "cli",
    "tui",
    "rust",
    "binary",
    "terminal",
    "speech",
    "tts"
  ],
  "type": "commonjs",
  "bin": {
    "xiaomimimo": "bin/xiaomimimo.js",
    "xiaomimimo-tui": "bin/xiaomimimo-tui.js"
  },
  "scripts": {
    "release:check": "node scripts/verify-release-assets.js",
    "postinstall": "node scripts/install.js",
    "prepublishOnly": "node scripts/verify-release-assets.js",
    "prepack": "node scripts/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "preferGlobal": true,
  "files": [
    "bin/*.js",
    "scripts/*.js",
    "README.md",
    "package.json"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ]
}
